# Copy this file to ".env" in the same folder, then fill in your values.
# Never share the real .env file (it has your database password).
APP_ENV=development
APP_TIMEZONE=Asia/Manila
SESSION_NAME=rp_mulawin_fms_v2
# Minutes of no activity before the user is logged out (0 = never).
SESSION_IDLE_MINUTES=60

# Database (default XAMPP: user root, no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mulawin_v2
DB_USER=root
DB_PASS=

# Printed on payslips and reports
COMPANY_NAME=R P MULAWIN TRUCKING SERVICE
COMPANY_ADDRESS=#086-A Purok 2 Brgy. Luyos Tanauan City, Batangas

# Only needed to create the FIRST Admin account in the browser
# (public/install.php). Use 32+ random characters, then clear it after setup.
INSTALL_TOKEN=
